# RealityEngine_CPP operational defaults

# Native service ports for the C++ deployment.
REALITY_ENGINE_PORT=5301
PERCEPTION_ENGINE_PORT=5300
VECTOR_DIMENSION=7680

# Active machine repository from RealityEngine_Machines.
MACHINES_DIR=../RealityEngine_Machines/machines

# Unified Qdrant vector store owned by localAIStack.
# localAIStack exposes Qdrant on host ports 4333 REST / 4334 gRPC and persists
# data in ../localAIStack/volumes/qdrant.
QDRANT_URL=http://localhost:4333
QDRANT_GRPC_URL=http://localhost:4334
QDRANT_STORAGE_DIR=../localAIStack/volumes/qdrant

# Shared collections used by localAIStack and active RealityEngine runtimes.
QDRANT_LOCALAI_COLLECTION=localai_docs
QDRANT_REALITY_COLLECTION=reality-vectors

# Optional local AI integration. The API shape matches localAIStack by default,
# but the C++ Perception Engine treats this as a configurable external AI API.
LOCAL_AI_API_URL=http://localhost:4000
LOCAL_AI_MACHINES_DIR=../localAIStack/data/machines
LOCAL_AI_BOOTSTRAP=false

# PE integration registry — unified localAIStack config (health + ACP/OpenClaw).
# When set, the PE loads this file at startup and routes /api/integrations/healthkit/ingest,
# /api/integrations/carekit/ingest, and /api/integrations/completions payloads to the
# declared perceptual-space regions.
# Path may be absolute or relative to the repo root (resolved at launch).
INTEGRATIONS_CONFIG=../localAIStack/config/integrations.json

# ACP / OpenClaw xACP handoff wiring for PE.
# Overrides the gatewayUrl / sessionKey / targetAgent in the integration registry.
ACP_ENABLED=true
ACP_GATEWAY_URL=ws://127.0.0.1:18789
OPENCLAW_GATEWAY_URL=ws://127.0.0.1:18789
ACP_SESSION_KEY=agent:main:main
ACP_TARGET_AGENT=openclaw
ACP_COMPLETION_SOURCE_MAPPING_ID=acp-openclaw-completion

# Optional HTTP transport tuning. Defaults are computed when unset:
# HTTP_WORKERS=max(2, hardware concurrency)
# HTTP_SESSION_TIMEOUT_MS=5000
# HTTP_MAX_KEEPALIVE_REQUESTS=32
# HTTP_IDEMPOTENCY_CACHE_SIZE=2048
# HTTP_CLIENT_TIMEOUT_MS=5000
# HTTP_CLIENT_POOL_SIZE=4
# DOMAIN_WORKERS=max(2, hardware concurrency)
# DOMAIN_QUEUE_CAPACITY=DOMAIN_WORKERS * 256
# HTTP_WORKERS=8
